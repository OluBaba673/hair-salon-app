# Copy this file to .env and change these values before running the app.

# Your Neon Postgres connection string. Get this from your Neon dashboard
# (Connection Details) after creating a project. Looks like:
# postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Password required to view/manage bookings on the admin page.
ADMIN_PASSWORD=changeme123

# Random string used to sign admin login sessions. Any long random text works.
SESSION_SECRET=please-change-this-to-something-random

# Port the app runs on. Visit http://localhost:PORT in your browser.
PORT=3000

# Gmail account used to send booking status emails to clients and to you.
EMAIL_USER=youraddress@gmail.com

# A Gmail "App Password" (not your real Gmail password) generated at
# myaccount.google.com/apppasswords. See README.md for how to create one.
EMAIL_APP_PASSWORD=
